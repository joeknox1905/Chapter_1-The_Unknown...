@article{https://doi.org/10.1111/2041-210X.12735,
author = {de Bello, Francesco and Šmilauer, Petr and Diniz-Filho, Jose Alexandre F. and Carmona, Carlos Perez and Lososová, Zdeňka and Herben, Tomáš and Götzenberger, Lars},
title = {Decoupling phylogenetic and functional diversity to reveal hidden signals in community assembly},
journal = {Methods in Ecology and Evolution},
volume = {8},
number = {10},
pages = {1200-1211},
keywords = {biodiversity, coexistence, ecosystem function, environmental filtering, limiting similarity, multivariate analyses, neutral theory, null models, phylogenetic corrections},
doi = {https://doi.org/10.1111/2041-210X.12735},
url = {https://besjournals.onlinelibrary.wiley.com/doi/abs/10.1111/2041-210X.12735},
eprint = {https://besjournals.onlinelibrary.wiley.com/doi/pdf/10.1111/2041-210X.12735},
abstract = {Summary Functional traits and phylogeny offer different, and often complementary, information about ecological differences between species, an essential step to uncover biodiversity assembly mechanisms and their feedbacks to ecosystem functions. However, traits and phylogeny are often related due to underlying trait evolution. Consequently, when combined, their shared information can be overemphasized, hindering their complementarity. It is therefore desirable to decouple their unique and overlapping contributions. We propose a conceptual and mathematical framework that produces a set of meaningful measures of ecological differences between species. We test the properties of these measures and the validity of the approach with extensive simulated data to show (i) the information provided by decoupling traits from phylogeny and vice versa, and (ii) that decoupling trait and phylogenetic information can uncover otherwise hidden signals underlying species coexistence and turnover. The application of the approach is further illustrated using a large dataset of Central European meadows as a case study. Decoupling traits and phylogeny particularly reveals the importance of differentiation between phylogenetically related species, which can be essential to understand species replacements along environmental gradients and the combined action of environmental filtering and limiting similarity within communities. Decoupling traits and phylogeny provides an avenue for connecting macro-evolutionary and local factors affecting coexistence and for understanding how complex species differences affect multiple ecosystem functions. We present an R function called ‘decouple’, which allows a simple and wide application of the framework.},
year = {2017}
}

@article{Parker2026,
   abstract = {Understanding how taxonomic, phylogenetic and functional diversity vary over environmental and anthropogenic gradients can shed light on what shapes species assemblages and inform conservation strategy. However, we have a limited understanding of this variation at national scales, a major scale for conservation decision‐making. Using camera‐trap data from 26 protected areas in Tanzania, one of the world's most important countries for mammal conservation, we assess how the taxonomic, phylogenetic and functional measures of richness of mammal assemblages vary with landscape heterogeneity and protection strength. We find that areas with greater landscape heterogeneity and stronger protection support more mammal species, ultimately leading to phylogenetically and functionally richer assemblages. Greater landscape heterogeneity appears to particularly benefit generalist species, whereas stronger protection seems to benefit species vulnerable to human‐wildlife conflict and hunting. We also identify community‐based conservation areas with relatively high mammal richness, and more isolated protected areas with low connectivity and relatively low richness. Our study demonstrates the potential of using extensive camera‐trap surveys to quantify and monitor these multiple dimensions of species assemblages, and to explore the environmental and anthropogenic factors that could affect them. We encourage further research to assess the mechanisms that drive variation in mammalian diversity over time and space, and their relationships with different management interventions.},
   author = {Ben G. Parker and Nathalie Pettorelli and Alex Lobora and Maurus J. Msuha and Joseph A. Tobias and Charles Foley and Sarah M. Durant},
   doi = {10.1111/acv.70083},
   issn = {1367-9430},
   journal = {Animal Conservation},
   month = {7},
   title = {Taxonomic, Phylogenetic and Functional Diversity of Mammals Across a Nationwide Protected Area Network},
   year = {2026}
}

