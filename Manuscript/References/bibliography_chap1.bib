@article{NUNES2026182318,
title = {Mapping potential global change impacts on biodiversity important areas of the contiguous US},
journal = {Science of The Total Environment},
volume = {1052},
pages = {182318},
year = {2026},
issn = {0048-9697},
doi = {https://doi.org/10.1016/j.scitotenv.2026.182318},
url = {https://www.sciencedirect.com/science/article/pii/S0048969726009861},
author = {Laura A. Nunes and Talia E. Niederman and Lindsay M. Dreiss},
keywords = {Global threats to biodiversity, Global change, Biodiversity loss, Ecosystem functioning, Biodiversity patterns},
abstract = {Global trends illustrate unprecedented declines in biodiversity. The main threats driving these trends include climate change, land- and sea-use change, pollution, over-exploitation, and invasive species. Strategic allocation of conservation resources is critical to address the drivers of biodiversity loss and safeguard biodiversity and its benefits to people. However, spatial assessments quantifying the relative potential impact of these drivers on important biodiversity areas are lacking at meaningful scales for national decision making. Here, we describe the distribution and intensity of the five main threats to biodiversity loss and their spatial overlaps with areas of relatively high terrestrial and freshwater biodiversity importance in the contiguous U.S. (CONUS). Proxies for each threat are based on publicly available spatial data considering both current and future projections when possible. We assess threat intensity in relation to protected area boundaries and biodiversity important areas, and quantify deviations in threat exposure between ecoregions and national scales. Overall, 41% of CONUS are areas of high conservation concern (i.e., medium-high biodiversity value and cumulative threat risk), concentrated along eastern and western coastal regions. Combined areas of highest threat intensity (90th percentile) also cover 40% of CONUS, and almost 20% are within current protected area network, leaving a significant amount of high threat intensity areas exempt from legislative protections. We found imperiled biodiversity exposure to individual and cumulative threats varies by geographic region and taxonomic group. We propose areas of low biodiversity importance but high threat intensity as candidates for policies aimed at preserving ecosystem intactness and human health. Our threat mapping assessment provides a baseline for conservation priorities across scales and could be used to develop spatially explicit guidance for mitigating threats to imperiled biodiversity in CONUS.}
}

@article{PFENNINGBUTTERWORTH2024e270,
title = {Interconnecting global threats: climate change, biodiversity loss, and infectious diseases},
journal = {The Lancet Planetary Health},
volume = {8},
number = {4},
pages = {e270-e283},
year = {2024},
issn = {2542-5196},
doi = {https://doi.org/10.1016/S2542-5196(24)00021-4},
url = {https://www.sciencedirect.com/science/article/pii/S2542519624000214},
author = {Alaina Pfenning-Butterworth and Lauren B Buckley and John M Drake and Johannah E Farner and Maxwell J Farrell and Alyssa-Lois M Gehman and Erin A Mordecai and Patrick R Stephens and John L Gittleman and T Jonathan Davies},
abstract = {Summary
The concurrent pressures of rising global temperatures, rates and incidence of species decline, and emergence of infectious diseases represent an unprecedented planetary crisis. Intergovernmental reports have drawn focus to the escalating climate and biodiversity crises and the connections between them, but interactions among all three pressures have been largely overlooked. Non-linearities and dampening and reinforcing interactions among pressures make considering interconnections essential to anticipating planetary challenges. In this Review, we define and exemplify the causal pathways that link the three global pressures of climate change, biodiversity loss, and infectious disease. A literature assessment and case studies show that the mechanisms between certain pairs of pressures are better understood than others and that the full triad of interactions is rarely considered. Although challenges to evaluating these interactions—including a mismatch in scales, data availability, and methods—are substantial, current approaches would benefit from expanding scientific cultures to embrace interdisciplinarity and from integrating animal, human, and environmental perspectives. Considering the full suite of connections would be transformative for planetary health by identifying potential for co-benefits and mutually beneficial scenarios, and highlighting where a narrow focus on solutions to one pressure might aggravate another.}
}

